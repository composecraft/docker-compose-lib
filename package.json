{
    "name": "@composecraft/docker-compose-lib",
    "version": "1.3.11",
    "description": "A library to help doing things around docker",
    "type": "commonjs",
    "main": "./lib/cjs/index.js",
    "module": "./lib/esm/index.js",
    "types": "./lib/cjs/index.d.ts",
    "exports": {
        ".": {
            "import": {
                "types": "./lib/esm/index.d.ts",
                "default": "./lib/esm/index.js"
            },
            "require": {
                "types": "./lib/cjs/index.d.ts",
                "default": "./lib/cjs/index.js"
            }
        },
        "./package.json": "./package.json"
    },
    "files": [
        "lib/"
    ],
    "repository": {
        "type": "git",
        "url": "git+https://github.com/composecraft/docker-compose-lib.git"
    },
    "homepage": "https://composecraft.github.io/docker-compose-lib/",
    "publishConfig": {
        "access": "public",
        "provenance": true
    },
    "scripts": {
        "clean": "rm -rf ./lib ./cov ./docs ./cache && rm -f ./testReal/*.js",
        "clear": "pnpm run clean",
        "build": "pnpm run clean && tsc -p tsconfig.json && tsc-alias -p tsconfig.json --resolve-full-paths && tsc -p tsconfig-cjs.json && tsc-alias -p tsconfig-cjs.json && pnpm run build:module-type",
        "build:module-type": "node -e \"require('fs').writeFileSync('lib/esm/package.json','{\\\"type\\\":\\\"module\\\"}\\n');require('fs').writeFileSync('lib/cjs/package.json','{\\\"type\\\":\\\"commonjs\\\"}\\n')\"",
        "typecheck": "tsc -p tsconfig.json --noEmit",
        "lint": "eslint src test scripts",
        "lint:fix": "eslint src test scripts --fix",
        "test": "jest",
        "test:real": "bash ./test.sh",
        "test:all": "pnpm run test && pnpm run test:real",
        "format": "prettier --write .",
        "format:check": "prettier --check .",
        "verify": "pnpm run lint && pnpm run typecheck && pnpm run test && pnpm run build",
        "doc": "typedoc --options ./typedoc.json",
        "changelog": "node scripts/changelog.mjs"
    },
    "keywords": [
        "docker",
        "library",
        "typescript",
        "javascript"
    ],
    "author": "Lucas Sovre",
    "license": "Apache-2.0",
    "packageManager": "pnpm@10.26.0",
    "devDependencies": {
        "@eslint/js": "^9.8.0",
        "@jest/globals": "^29.7.0",
        "@types/jest": "^29.5.12",
        "@types/node": "^22.0.0",
        "eslint": "^9.8.0",
        "globals": "^15.8.0",
        "jest": "^29.7.0",
        "prettier": "3.3.3",
        "ts-jest": "^29.2.3",
        "ts-node": "^10.9.2",
        "tsc-alias": "^1.8.10",
        "typedoc": "^0.27.5",
        "typescript": "^5.5.4",
        "typescript-eslint": "^7.18.0",
        "yaml": "^2.5.0"
    },
    "pnpm": {
        "overrides": {
            "micromatch": "^4.0.8",
            "@babel/helpers": "^7.29.2",
            "cross-spawn": "^7.0.6",
            "brace-expansion": "^2.0.2",
            "diff": "^4.0.4",
            "js-yaml": "^4.1.1",
            "markdown-it": "^14.1.1",
            "ajv": "^6.15.0",
            "flatted": "^3.4.2",
            "picomatch": "^2.3.2",
            "yaml": "^2.8.4",
            "@typescript-eslint/typescript-estree>minimatch": "^9.0.9"
        }
    }
}
